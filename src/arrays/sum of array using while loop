#include <stdio.h>
//#define z 100
int main()
{
    int i,z,sum;
    sum=0;
    
    printf("enter array size:");
    scanf("%d",&z);
    int arr[z];
    for(i=0;i<z;i++){
        printf("element of arr[%d]:",i);
        scanf("%d",&arr[i]);
    }
    i=0;
    while(i<z){
        sum=sum+arr[i];
        i++;
    }
    printf("sum is :%d",sum);
    return 0;
}
